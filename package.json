{
  "name": "codex-with-chatgpt",
  "version": "0.1.3",
  "description": "ChatGPT thinks. Codex works. Use ChatGPT as the planning brain while keeping the Codex harness.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "c2c": "./bin/c2c.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime.mjs",
    "dev": "tsx src/cli/index.ts",
    "dashboard": "node dist/dashboard/server.js",
    "dashboard:dev": "tsx src/dashboard/server.ts",
    "human-approver": "node dist/human-approver/server.js",
    "human-approver:dev": "tsx src/human-approver/server.ts",
    "approver:pack": "pnpm build && node scripts/pack-ai-approver.mjs",
    "ct700:pack": "pnpm build && node scripts/pack-ct700-approver.mjs",
    "ct700:verify-package": "node scripts/verify-ct700-approver-package.mjs",
    "ct702:serve": "node dist/review-service/production-cli.js serve",
    "ct702:pack": "pnpm build && node scripts/pack-ct702-review.mjs",
    "ct702:verify-package": "node scripts/verify-ct702-review-package.mjs",
    "ct702:clean-room": "node scripts/verify-ct702-review-package.mjs",
    "ct702:test": "vitest run tests/ct702-review.test.ts tests/ct702-package-integrity.test.ts",
    "finalizer:pack": "pnpm build && node scripts/pack-ct701-finalizer.mjs",
    "finalizer:verify-package": "node --jitless scripts/verify-ct701-package.mjs",
    "test": "vitest run",
    "verify:fast": "node scripts/verify-ai-workspace.mjs FAST",
    "verify:review": "node scripts/verify-ai-workspace.mjs REVIEW",
    "verify:full": "node scripts/verify-ai-workspace.mjs FULL",
    "test:rc01:a": "node scripts/verify-rc01-phase-a.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "@opencode/ai": "2.0.22",
    "@opencode/core": "2.0.22",
    "@opencode/util": "2.0.22",
    "@simplewebauthn/server": "^13.3.3",
    "commander": "^14.0.0",
    "effect": "4.0.0-rc.112",
    "express": "^5.1.0",
    "ignore": "^7.0.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
